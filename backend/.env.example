# Server
PORT=5000
NODE_ENV=development

# Database
# Local:      mongodb://localhost:27017/feedants
# Atlas SRV:  mongodb+srv://<user>:<pass>@<cluster>/feedants?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/feedants

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - the origin(s) the React Native app / Metro bundler runs from
CLIENT_ORIGIN=*

# File uploads (local disk in dev - see README for S3 notes in prod)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
